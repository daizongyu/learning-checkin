{
  "name": "learning-checkin",
  "version": "1.0.0",
  "title": "Learning Check-in",
  "description": "Global learning check-in system with streak tracking, leaderboard, and failure detection. No GitHub account required!",
  "author": "Learning Check-in Team",
  "license": "MIT",
  "homepage": "https://github.com/YOUR_USERNAME/learning-checkin",
  "repository": "https://github.com/YOUR_USERNAME/learning-checkin.git",
  "bugs": "https://github.com/YOUR_USERNAME/learning-checkin/issues",
  "keywords": [
    "learning",
    "check-in",
    "streak",
    "leaderboard",
    "productivity",
    "education",
    "habit-tracking"
  ],
  "category": "Productivity",
  "python_version": ">=3.8",
  "entry_point": "checkin_cli.py",
  "main_command": "python checkin_cli.py",
  "commands": [
    {
      "name": "init",
      "description": "Initialize new user",
      "usage": "python checkin_cli.py init --nickname <name> --country <code>",
      "examples": [
        "python checkin_cli.py init --nickname Daisy --country CN"
      ],
      "parameters": [
        {
          "name": "--nickname",
          "required": true,
          "description": "User nickname (displayed on leaderboard)"
        },
        {
          "name": "--country",
          "required": true,
          "description": "Country code (e.g., CN, US, UK)"
        }
      ]
    },
    {
      "name": "checkin",
      "description": "Daily check-in",
      "usage": "python checkin_cli.py checkin [--note <text>]",
      "examples": [
        "python checkin_cli.py checkin",
        "python checkin_cli.py checkin --note \"Studied Python for 2 hours\""
      ],
      "parameters": [
        {
          "name": "--note",
          "required": false,
          "description": "Optional note about what you learned"
        }
      ]
    },
    {
      "name": "status",
      "description": "View current check-in status",
      "usage": "python checkin_cli.py status"
    },
    {
      "name": "leaderboard",
      "description": "View global leaderboard",
      "usage": "python checkin_cli.py leaderboard [--country <code>]",
      "examples": [
        "python checkin_cli.py leaderboard",
        "python checkin_cli.py leaderboard --country US"
      ],
      "parameters": [
        {
          "name": "--country",
          "required": false,
          "description": "Filter by country code"
        }
      ]
    },
    {
      "name": "rank",
      "description": "View your ranking",
      "usage": "python checkin_cli.py rank"
    },
    {
      "name": "check-update",
      "description": "Check for Skill updates",
      "usage": "python checkin_cli.py check-update"
    }
  ],
  "dependencies": [
    "requests>=2.28.0"
  ],
  "platforms": [
    "Windows",
    "Linux",
    "macOS"
  ],
  "features": [
    "Zero configuration - no GitHub account needed",
    "Cross-platform support (Windows, Linux, macOS)",
    "Global leaderboard with country filtering",
    "Automatic streak tracking",
    "Weekly failure detection",
    "Auto-update notification",
    "Anonymous user IDs",
    "Public data repository"
  ],
  "screenshots": [
    "screenshots/init.png",
    "screenshots/checkin.png",
    "screenshots/status.png",
    "screenshots/leaderboard.png"
  ],
  "quick_start": {
    "title": "Quick Start",
    "steps": [
      {
        "step": 1,
        "command": "pip install -r requirements.txt",
        "description": "Install dependencies"
      },
      {
        "step": 2,
        "command": "python checkin_cli.py init --nickname YourName --country CN",
        "description": "Initialize your user account"
      },
      {
        "step": 3,
        "command": "python checkin_cli.py checkin",
        "description": "Start checking in daily"
      }
    ]
  },
  "rules": [
    "Check in at least once per day",
    "Miss ≥2 days in a week = task failed",
    "Can rejoin anytime after failure",
    "Streak resets if you miss a day"
  ],
  "data_storage": {
    "local": "~/.learning-checkin/config.json",
    "remote": "https://github.com/daizongyu/learning-checkin-data",
    "privacy": "User ID is anonymous, only nickname is public"
  },
  "update_mechanism": {
    "type": "notification",
    "frequency": "Every command",
    "method": "GitHub API version check",
    "action": "Manual download and update"
  }
}
